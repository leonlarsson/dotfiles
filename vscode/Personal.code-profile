{"name": "Personal", "settings": "{\"settings\": \"{\\n  // Editor\\n  \\\"editor.fontFamily\\\": \\\"JetBrains Mono, Consolas, monospace\\\",\\n  \\\"editor.formatOnSave\\\": true,\\n  \\\"editor.codeActionsOnSave\\\": {\\n    \\\"source.fixAll.biome\\\": \\\"explicit\\\",\\n    \\\"source.organizeImports.biome\\\": \\\"explicit\\\"\\n  },\\n  \\\"editor.wordWrap\\\": \\\"on\\\",\\n  \\\"editor.linkedEditing\\\": true,\\n  \\\"editor.stickyScroll.enabled\\\": true,\\n  \\\"editor.guides.bracketPairs\\\": true,\\n  \\\"editor.suggestSelection\\\": \\\"first\\\",\\n  \\\"editor.unicodeHighlight.ambiguousCharacters\\\": false,\\n\\n  // Formatters\\n  \\\"[javascript][typescript][javascriptreact][typescriptreact][json][jsonc][css][graphql]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"biomejs.biome\\\"\\n  },\\n\\n  // TypeScript\\n  \\\"typescript.updateImportsOnFileMove.enabled\\\": \\\"always\\\",\\n  \\\"typescript.inlayHints.parameterNames.enabled\\\": \\\"literals\\\",\\n\\n  // Workbench\\n  \\\"workbench.colorTheme\\\": \\\"Bearded Theme Arc\\\",\\n  \\\"workbench.colorCustomizations\\\": {\\n    \\\"[Bearded Theme Arc]\\\": {\\n      \\\"commandCenter.foreground\\\": \\\"#afbbd2\\\",\\n      \\\"commandCenter.border\\\": \\\"#2e3b54\\\",\\n      \\\"titleBar.activeForeground\\\": \\\"#afbbd2\\\"\\n    }\\n  },\\n  \\\"workbench.editor.labelFormat\\\": \\\"short\\\",\\n  \\\"window.commandCenter\\\": true,\\n  \\\"update.showReleaseNotes\\\": false,\\n\\n  // Explorer\\n  \\\"explorer.compactFolders\\\": false,\\n  \\\"explorer.confirmDelete\\\": false,\\n  \\\"explorer.confirmDragAndDrop\\\": false,\\n\\n  // Git\\n  \\\"git.autofetch\\\": true,\\n  \\\"git.confirmSync\\\": false,\\n  \\\"githubPullRequests.pullBranch\\\": \\\"never\\\",\\n  \\\"githubPullRequests.createOnPublishBranch\\\": \\\"never\\\",\\n\\n  // AI\\n  \\\"chat.disableAIFeatures\\\": true,\\n  \\\"claudeCode.useTerminal\\\": true,\\n\\n  // Terminal / remote\\n  \\\"terminal.integrated.initialHint\\\": false,\\n  \\\"remote.autoForwardPortsSource\\\": \\\"hybrid\\\"\\n}\\n\"}", "keybindings": "{\"keybindings\": \"[\\n  // Toggle focus between editor and terminal\\n  {\\n    \\\"key\\\": \\\"alt+backspace\\\",\\n    \\\"command\\\": \\\"workbench.action.terminal.focus\\\",\\n    \\\"when\\\": \\\"!terminalFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"alt+backspace\\\",\\n    \\\"command\\\": \\\"workbench.action.focusActiveEditorGroup\\\",\\n    \\\"when\\\": \\\"terminalFocus\\\"\\n  },\\n\\n  // Newline in Claude Code (terminal)\\n  {\\n    \\\"key\\\": \\\"shift+enter\\\",\\n    \\\"command\\\": \\\"workbench.action.terminal.sendSequence\\\",\\n    \\\"args\\\": { \\\"text\\\": \\\"\\\\u001b\\\\r\\\" },\\n    \\\"when\\\": \\\"terminalFocus\\\"\\n  },\\n\\n  // Quick text search\\n  {\\n    \\\"key\\\": \\\"ctrl+k ctrl+f\\\",\\n    \\\"command\\\": \\\"workbench.action.quickTextSearch\\\"\\n  },\\n\\n  // Comment line (Nordic layout friendly)\\n  {\\n    \\\"key\\\": \\\"ctrl+numpad_divide\\\",\\n    \\\"command\\\": \\\"editor.action.commentLine\\\",\\n    \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\n  }\\n]\\n\", \"platform\": 3}", "snippets": "{\"snippets\": {\"clog.code-snippets\": \"{\\n  \\\"Print to console\\\": {\\n    \\\"scope\\\": \\\"javascript,typescript,javascriptreact,typescriptreact\\\",\\n    \\\"prefix\\\": \\\"clog\\\",\\n    \\\"body\\\": [\\\"console.log($1);$0\\\"],\\n    \\\"description\\\": \\\"Log output to console\\\"\\n  }\\n}\\n\"}}", "extensions": "[{\"identifier\": {\"id\": \"anthropic.claude-code\"}, \"displayName\": \"anthropic.claude-code\", \"applicationScoped\": false}, {\"identifier\": {\"id\": \"beardedbear.beardedtheme\"}, \"displayName\": \"beardedbear.beardedtheme\", \"applicationScoped\": false}, {\"identifier\": {\"id\": \"biomejs.biome\"}, \"displayName\": \"biomejs.biome\", \"applicationScoped\": false}, {\"identifier\": {\"id\": \"yoavbls.pretty-ts-errors\"}, \"displayName\": \"yoavbls.